@echo off
setlocal EnableDelayedExpansion
title FFmpeg Setup -- Apti Talent
color 0B
cls

echo.
echo  +========================================================+
echo  ^|              FFmpeg Auto-Setup Utility                 ^|
echo  ^|                    Apti Talent                         ^|
echo  +========================================================+
echo.

:: ?????????????????????????????????????????????????????????
:: STEP 1: Check if ffmpeg already works
:: ?????????????????????????????????????????????????????????
where ffmpeg >nul 2>&1
if %errorlevel%==0 (
    echo  [OK] FFmpeg is already installed and in your PATH.
    echo.
    ffmpeg -version 2>&1 | findstr /i "ffmpeg version"
    echo.
    echo  No action needed. You are good to go!
    echo.
    pause
    exit /b 0
)

:: ?????????????????????????????????????????????????????????
:: STEP 2: Check local ffmpeg_bin folder (previously downloaded)
:: ?????????????????????????????????????????????????????????
set "LOCAL_FFMPEG=%~dp0ffmpeg_bin\ffmpeg.exe"
if exist "%LOCAL_FFMPEG%" (
    echo  [OK] FFmpeg found locally at:
    echo       %LOCAL_FFMPEG%
    echo.
    goto :ask_path
)

:: ?????????????????????????????????????????????????????????
:: STEP 3: Download FFmpeg
:: ?????????????????????????????????????????????????????????
echo  FFmpeg is NOT installed on this computer.
echo  Downloading FFmpeg now using Python...
echo.

if not exist "%~dp0ffmpeg_bin" mkdir "%~dp0ffmpeg_bin"

python -c "
import urllib.request, zipfile, shutil, os
from pathlib import Path

script_dir = Path(r'%~dp0')
ffmpeg_dir = script_dir / 'ffmpeg_bin'
ffmpeg_exe = ffmpeg_dir / 'ffmpeg.exe'
zip_path   = ffmpeg_dir / 'ffmpeg_dl.zip'

url = 'https://github.com/GyanD/codexffmpeg/releases/download/7.1.1/ffmpeg-7.1.1-essentials_build.zip'

print('  Connecting to GitHub...')

def progress(b, bs, total):
    done = b * bs
    if total > 0:
        pct = min(100, done * 100 // total)
        bar = chr(9608) * (pct // 5) + chr(9617) * (20 - pct // 5)
        mb  = done / (1024*1024)
        tot = total / (1024*1024)
        print(f'\r  [{bar}] {pct}%  {mb:.1f}/{tot:.1f} MB', end='', flush=True)

urllib.request.urlretrieve(url, zip_path, reporthook=progress)
print()
print('  Extracting...')
with zipfile.ZipFile(zip_path, 'r') as zf:
    hits = [n for n in zf.namelist() if n.endswith('bin/ffmpeg.exe')]
    zf.extract(hits[0], ffmpeg_dir / '_tmp')

extracted = ffmpeg_dir / '_tmp' / hits[0]
extracted.replace(ffmpeg_exe)
shutil.rmtree(ffmpeg_dir / '_tmp', ignore_errors=True)
zip_path.unlink(missing_ok=True)
print(f'  Done! FFmpeg saved to: {ffmpeg_exe}')
"

if %errorlevel% neq 0 (
    echo.
    echo  ERROR: Download failed. Check your internet connection.
    echo  Or download manually from: https://ffmpeg.org/download.html
    echo  and place ffmpeg.exe inside the ffmpeg_bin folder here.
    echo.
    pause
    exit /b 1
)

echo.
echo  [OK] FFmpeg downloaded successfully!
echo.

:ask_path
:: ?????????????????????????????????????????????????????????
:: STEP 4: Ask the user about PATH
:: ?????????????????????????????????????????????????????????
set "LOCAL_FFMPEG=%~dp0ffmpeg_bin\ffmpeg.exe"
echo.
echo  ???????????????????????????????????????????????????????
echo  ?            Add FFmpeg to PATH?                      ?
echo  ?                                                     ?
echo  ?  Option 1 -- YES, add to MY account (recommended)  ?
echo  ?    - No admin/password needed                       ?
echo  ?    - FFmpeg works in this account only              ?
echo  ?    - Works in Command Prompt, Python, everywhere    ?
echo  ?                                                     ?
echo  ?  Option 2 -- YES, add for ALL users (system-wide)  ?
echo  ?    - Requires ADMIN permission (Windows will ask)   ?
echo  ?    - FFmpeg works for every user on this PC         ?
echo  ?                                                     ?
echo  ?  Option 3 -- NO, just use it from this folder      ?
echo  ?    - No changes to your system                      ?
echo  ?    - Only works when run through this folder        ?
echo  ???????????????????????????????????????????????????????
echo.
set /p "CHOICE=  Enter 1, 2, or 3: "

if "%CHOICE%"=="1" goto :user_path
if "%CHOICE%"=="2" goto :system_path
if "%CHOICE%"=="3" goto :skip_path

echo  Invalid choice. Defaulting to Option 3 (no PATH change).
goto :skip_path

:: ?????????????????????????????????????????????????????????
:: OPTION 1: Add to USER PATH (no admin needed)
:: ?????????????????????????????????????????????????????????
:user_path
echo.
echo  Adding FFmpeg to your account PATH...
set "FFMPEG_DIR=%~dp0ffmpeg_bin"

:: Use PowerShell to add to current user PATH (no UAC needed)
powershell -NoProfile -Command ^
  "$old = [Environment]::GetEnvironmentVariable('Path','User');" ^
  "if ($old -notlike '*ffmpeg_bin*') {" ^
  "  $new = $old + ';' + '%FFMPEG_DIR%';" ^
  "  [Environment]::SetEnvironmentVariable('Path', $new, 'User');" ^
  "  Write-Host '  PATH updated for your account.'" ^
  "} else {" ^
  "  Write-Host '  ffmpeg_bin is already in your PATH.'" ^
  "}"

echo.
echo  [OK] Done! Open a NEW Command Prompt and type:
echo       ffmpeg -version
echo  to confirm it works.
goto :done

:: ?????????????????????????????????????????????????????????
:: OPTION 2: Add to SYSTEM PATH (admin required, self-elevate)
:: ?????????????????????????????????????????????????????????
:system_path
echo.
echo  Windows will ask for Administrator permission now...
echo  Click YES in the popup to continue.
echo.

set "FFMPEG_DIR=%~dp0ffmpeg_bin"

:: Write a temp PowerShell script to run elevated
set "PS_TEMP=%TEMP%\ffmpeg_syspath.ps1"
(
echo $ffmpegDir = '%FFMPEG_DIR%'
echo $regPath   = 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment'
echo $old = [Environment]::GetEnvironmentVariable^('Path','Machine'^)
echo if ^($old -notlike "*ffmpeg_bin*"^) {
echo   $new = $old + ';' + $ffmpegDir
echo   [Environment]::SetEnvironmentVariable^('Path', $new, 'Machine'^)
echo   Write-Host 'System PATH updated.'
echo } else {
echo   Write-Host 'ffmpeg_bin already in system PATH.'
echo }
) > "%PS_TEMP%"

:: Self-elevate with UAC
powershell -NoProfile -Command ^
  "Start-Process powershell -ArgumentList '-NoProfile -ExecutionPolicy Bypass -File ""%PS_TEMP%""' -Verb RunAs -Wait"

del "%PS_TEMP%" >nul 2>&1

echo.
echo  [OK] Done! Open a NEW Command Prompt and type:
echo       ffmpeg -version
echo  to confirm it works globally.
goto :done

:: ?????????????????????????????????????????????????????????
:: OPTION 3: No PATH change
:: ?????????????????????????????????????????????????????????
:skip_path
echo.
echo  [OK] No PATH changes made.
echo  FFmpeg will be used from: %LOCAL_FFMPEG%
echo  This works fine with encoder.py and Compress Video.bat.

:done
echo.
echo  +========================================================+
echo  ^|                 Setup Complete!                        ^|
echo  ^|                                                        ^|
echo  ^|  Now double-click "Compress Video.bat" to compress     ^|
echo  ^|  your screen recordings.                               ^|
echo  +========================================================+
echo.
pause
exit /b 0
